# Copy to .env and fill in. `docker compose` loads .env automatically.

POSTGRES_DB=miqat
POSTGRES_USER=miqat
POSTGRES_PASSWORD=change-me

# Generate one with: head -c 48 /dev/urandom | base64
JWT_SECRET_KEY=

# From Google Cloud Console. Must match the client ID the Angular app uses.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Brevo (ex-Sendinblue) transactional API key — this is what actually sends OTP
# and welcome emails. Leave blank and the code is logged to the container instead
# ("[Dev OTP] ..."), while the API still returns 200.
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Miqat

# Brevo SMTP relay — used when EMAIL_API_KEY is blank.
EMAIL_SMTP_HOST=smtp-relay.brevo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USE_SSL=false
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# Azure Blob Storage for profile pictures (optional).
AZURE_STORAGE_CONNECTION=
AZURE_STORAGE_CONTAINER=user-images
